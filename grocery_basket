@dataclass
class Product:
    name: str
    category: str
    annual: float       # годовая норма на одного жителя (кг, л или шт.)
    unit: str           # "кг", "л", "шт", "буханка"
    price: float        # закупочная цена за единицу, руб
    weight: float       # сколько весит одна единица, кг (для загрузки фургона)
    rural: float = 1.0  # поправка на село: 0.2 = берут в 5 раз меньше (своё с огорода), 1.2 = берут больше (негде купить альтернативу)
 
    @property
    def adjusted_annual(self) -> float:
        return self.annual * self.rural
 
 
@dataclass
class Village:
    name: str
    place_type: str
    region: str
    district: str
    population: int
 
    @classmethod
    def from_route_row(cls, row: dict) -> "Village":
        place = (row.get("Тип") or "village").strip()
        return cls(
            name=row.get("Название", "").strip(),
            place_type=place,
            region=row.get("Регион", "").strip(),
            district=row.get("Район", "").strip(),
            population=POP_BY_TYPE.get(place, 30),
        )
 
 
@dataclass
class BasketParams:
    frequency_days: int = 7   # раз в сколько дней приезжаем
    reach: float = 0.30       # доля жителей, которая реально покупает
    margin: float = 0.25      # торговая наценка
    waste: float = 0.10       # запас на порчу и неучтённый спрос
 
    @property
    def cycle_fraction(self) -> float:
        return self.frequency_days / 365
 
 
