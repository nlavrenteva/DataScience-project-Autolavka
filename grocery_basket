def load_route(path: str) -> list[Village]:
    villages = []
    with open(path, encoding="utf-8-sig", newline="") as f:
        reader = csv.DictReader(f)
        for row in reader:
            if not row.get("Название", "").strip():
                continue
            villages.append(Village.from_route_row(row))
    return villages
 
 
def village_basket(village: Village, params: BasketParams) -> list[dict]:
    buyers = village.population * params.reach
    items = []
    for p in BASKET:
        qty = p.adjusted_annual * params.cycle_fraction * buyers
        if qty < 0.05:
            continue
        items.append({
            "product": p.name,
            "category": p.category,
            "unit": p.unit,
            "qty": round(qty, 2),
            "weight": round(qty * p.weight, 2),
            "cost": round(qty * p.price, 2),
        })
    return items
 
 
def total_for_van(villages: list[Village], params: BasketParams) -> list[dict]:
    totals: dict[str, dict] = {}
    for v in villages:
        for item in village_basket(v, params):
            name = item["product"]
            if name not in totals:
                totals[name] = {
                    "product": name,
                    "category": item["category"],
                    "unit": item["unit"],
                    "qty": 0,
                    "weight": 0,
                    "cost": 0,
                }
            totals[name]["qty"] += item["qty"]
            totals[name]["weight"] += item["weight"]
            totals[name]["cost"] += item["cost"]
 
    # запас на порчу и неучтённый спрос
    for t in totals.values():
        t["qty"] = round(t["qty"] * (1 + params.waste), 2)
        t["weight"] = round(t["weight"] * (1 + params.waste), 2)
        t["cost"] = round(t["cost"] * (1 + params.waste), 2)
        t["revenue"] = round(t["cost"] * (1 + params.margin), 2)
        t["profit"] = round(t["revenue"] - t["cost"], 2)
 
    return sorted(totals.values(), key=lambda x: (x["category"], -x["cost"]))
 
 
def save_van_load(rows: list[dict], path: Path,
                  villages: list[Village], params: BasketParams) -> None:
    total_weight = sum(r["weight"] for r in rows)
    total_cost = sum(r["cost"] for r in rows)
    total_revenue = sum(r["revenue"] for r in rows)
    total_pop = sum(v.population for v in villages)
 
    with open(path, "w", encoding="utf-8-sig", newline="") as f:
        w = csv.writer(f)
        w.writerow(["Категория", "Товар", "Кол-во", "Ед.",
                    "Вес, кг", "Закупка, ₽", "Выручка, ₽", "Прибыль, ₽"])
        for r in rows:
            w.writerow([r["category"], r["product"], r["qty"], r["unit"],
                        r["weight"], r["cost"], r["revenue"], r["profit"]])
 
        w.writerow([])
        w.writerow(["ИТОГО", "", "", "",
                    round(total_weight, 1),
                    round(total_cost),
                    round(total_revenue),
                    round(total_revenue - total_cost)])
        w.writerow([])
        w.writerow([f"Маршрут: {len(villages)} деревень, ~{total_pop} жителей, "
                    f"охват {int(params.reach * 100)}%, "
                    f"завоз раз в {params.frequency_days} дн., "
                    f"наценка {int(params.margin * 100)}%"])
 
 
def save_per_village(villages: list[Village], path: Path,
                     params: BasketParams) -> None:
    with open(path, "w", encoding="utf-8-sig", newline="") as f:
        w = csv.writer(f)
        w.writerow(["Деревня", "Район", "Тип", "Население",
                    "Категория", "Товар", "Кол-во", "Ед.", "Выручка, ₽"])
        for v in villages:
            for item in village_basket(v, params):
                revenue = round(item["cost"] * (1 + params.margin), 2)
                w.writerow([v.name, v.district, v.place_type, v.population,
                            item["category"], item["product"], item["qty"],
                            item["unit"], revenue])
 
 
def print_summary(rows: list[dict], villages: list[Village],
                  params: BasketParams) -> None:
    total_weight = sum(r["weight"] for r in rows)
    total_cost = sum(r["cost"] for r in rows)
    total_revenue = sum(r["revenue"] for r in rows)
    total_pop = sum(v.population for v in villages)
    buyers = int(total_pop * params.reach)
 
    print()
    print(f"Маршрут: {len(villages)} деревень, ~{total_pop} жителей")
    print(f"Покупателей ожидается: ~{buyers} ({int(params.reach*100)}%)")
    print(f"Завоз раз в {params.frequency_days} дн., "
          f"наценка {int(params.margin*100)}%, "
          f"запас на порчу {int(params.waste*100)}%")
    print("-" * 50)
    print(f"Вес товара:       {total_weight:>8.1f} кг")
    print(f"Закупка:          {total_cost:>8.0f} ₽")
    print(f"Выручка:          {total_revenue:>8.0f} ₽")
    print(f"Прибыль:          {total_revenue - total_cost:>8.0f} ₽")
    print()
 
    # Топ-10 по выручке
    top = sorted(rows, key=lambda x: -x["revenue"])[:10]
    print("Топ-10 товаров по выручке:")
    for r in top:
        print(f"  {r['product']:<28} {r['qty']:>7.1f} {r['unit']:<8} "
              f"{r['revenue']:>8.0f} ₽")
    print()
 
    # По категориям
    cats: dict[str, dict] = {}
    for r in rows:
        c = cats.setdefault(r["category"], {"weight": 0, "cost": 0, "revenue": 0})
        c["weight"] += r["weight"]
        c["cost"] += r["cost"]
        c["revenue"] += r["revenue"]
 
    print("По категориям:")
    for name, c in sorted(cats.items(), key=lambda x: -x[1]["revenue"]):
        print(f"  {name:<18} вес {c['weight']:>6.1f} кг, "
              f"выручка {c['revenue']:>8.0f} ₽")
 
 
def process_route(route_path: Path, out_dir: Path, params: BasketParams) -> None:
    villages = load_route(str(route_path))
    if not villages:
        print(f"  {route_path.name}: пусто, пропускаем")
        return
 
    rows = total_for_van(villages, params)
 
    slug = route_path.stem.replace("route_", "")
    van_file = out_dir / f"van_load_{slug}.csv"
    village_file = out_dir / f"per_village_{slug}.csv"
 
    save_van_load(rows, van_file, villages, params)
    save_per_village(villages, village_file, params)
 
    print(f"\n>>> {route_path.name}")
    print_summary(rows, villages, params)
    print(f"Сохранено: {van_file}")
    print(f"Сохранено: {village_file}")
 
 
def main() -> None:
    parser = argparse.ArgumentParser(
        description="Считаем корзину товаров для мобильной лавки")
    parser.add_argument("--route", help="один CSV-файл маршрута")
    parser.add_argument("--all-routes", help="папка со всеми CSV-маршрутами")
    parser.add_argument("--frequency", type=int, default=7,
                        help="раз в сколько дней приезжаем (по умолч. 7)")
    parser.add_argument("--reach", type=float, default=0.30,
                        help="доля покупателей от 0 до 1 (по умолч. 0.30)")
    parser.add_argument("--margin", type=float, default=0.25,
                        help="наценка от 0 до 1 (по умолч. 0.25)")
    parser.add_argument("--waste", type=float, default=0.10,
                        help="запас на порчу (по умолч. 0.10)")
    parser.add_argument("--out", default="basket_output",
                        help="папка для выходных файлов")
    args = parser.parse_args()
 
    out_dir = Path(args.out)
    out_dir.mkdir(parents=True, exist_ok=True)
 
    params = BasketParams(
        frequency_days=args.frequency,
        reach=args.reach,
        margin=args.margin,
        waste=args.waste,
    )
 
    if args.all_routes:
        folder = Path(args.all_routes)
        files = sorted(folder.glob("route_*.csv"))
        if not files:
            files = sorted(folder.glob("*.csv"))
        if not files:
            print(f"В папке {folder} нет CSV-файлов")
            return
        print(f"Найдено маршрутов: {len(files)}")
        for f in files:
            process_route(f, out_dir, params)
    elif args.route:
        process_route(Path(args.route), out_dir, params)
    else:
        print("Укажите --route файл.csv или --all-routes папка/")
 
 
if __name__ == "__main__":
    main()
 
